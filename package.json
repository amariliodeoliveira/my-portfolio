{
  "name": "my-portfolio",
  "version": "1.1.0",
  "type": "module",
  "description": "Personal portfolio website of Amarilio de Oliveira, showcasing software development projects with Next.js, React, and TypeScript",
  "author": "Amarilio de Oliveira",
  "repository": "https://github.com/amariliodeoliveira/my-portfolio",
  "packageManager": "npm@12.0.2",
  "keywords": [
    "portfolio",
    "nextjs",
    "react",
    "typescript",
    "software-developer"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --fix-type layout",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run type-check && npm run format:check && npm run lint && npm run test:aeo",
    "test:aeo": "node --test tests/aeo-*.test.ts",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "postbuild": "node scripts/postbuild.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aeo.js": "^0.0.16",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@iconify/react": "^6.0.2",
    "@playwright/test": "^1.62.1",
    "@semantic-release/git": "^11.0.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "daisyui": "^5.7.22",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "volta": {
    "node": "24.18.1",
    "npm": "12.0.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
